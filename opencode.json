{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "godot-mcp": {
        "type": "local",
        "command": ["npx", "-y", "@coding-solo/godot-mcp"],
        "environment": {
          "GODOT_PATH": "godot"
        }
      },
      "pixelart-mcp": {
        "type": "local",
        "command": [
          "uv",
          "--directory",
          "mcp-servers\\pixelart-mcp",
          "run",
          "-m",
          "pixelart_mcp"
        ]
      },
      "blender-asset-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "--python",
          "3.12",
          "--from",
          "git+https://github.com/yi00it/blender-asset-mcp",
          "blender-asset-mcp"
        ]
      }
    }
  }
}
